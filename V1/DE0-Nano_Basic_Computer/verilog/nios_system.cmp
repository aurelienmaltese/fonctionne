	component nios_system is
		port (
			zs_addr_from_the_SDRAM               : out   std_logic_vector(12 downto 0);                    -- addr
			zs_ba_from_the_SDRAM                 : out   std_logic_vector(1 downto 0);                     -- ba
			zs_cas_n_from_the_SDRAM              : out   std_logic;                                        -- cas_n
			zs_cke_from_the_SDRAM                : out   std_logic;                                        -- cke
			zs_cs_n_from_the_SDRAM               : out   std_logic;                                        -- cs_n
			zs_dq_to_and_from_the_SDRAM          : inout std_logic_vector(15 downto 0) := (others => 'X'); -- dq
			zs_dqm_from_the_SDRAM                : out   std_logic_vector(1 downto 0);                     -- dqm
			zs_ras_n_from_the_SDRAM              : out   std_logic;                                        -- ras_n
			zs_we_n_from_the_SDRAM               : out   std_logic;                                        -- we_n
			DIP_to_the_Dip_switches              : in    std_logic_vector(3 downto 0)  := (others => 'X'); -- export
			reset_n                              : in    std_logic                     := 'X';             -- reset_n
			GPIO_0_to_and_from_the_Expansion_JP1 : inout std_logic_vector(31 downto 0) := (others => 'X'); -- export
			LEDG_from_the_Green_LEDs             : out   std_logic_vector(7 downto 0);                     -- export
			GPIO_2_to_and_from_the_Expansion_JP3 : inout std_logic_vector(12 downto 0) := (others => 'X'); -- export
			GPIO_1_to_and_from_the_Expansion_JP2 : inout std_logic_vector(31 downto 0) := (others => 'X'); -- export
			clk                                  : in    std_logic                     := 'X';             -- clk
			KEY_to_the_Pushbuttons               : in    std_logic_vector(1 downto 0)  := (others => 'X'); -- export
			GPIO_2_IN_to_the_Expansion_JP3_In    : in    std_logic_vector(2 downto 0)  := (others => 'X'); -- export
			motor_pwm_pwm_left                   : out   std_logic;                                        -- pwm_left
			motor_pwm_pwm_right                  : out   std_logic;                                        -- pwm_right
			motor_pwm_dir_left                   : out   std_logic;                                        -- dir_left
			motor_pwm_dir_right                  : out   std_logic                                         -- dir_right
		);
	end component nios_system;

